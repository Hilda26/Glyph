{
  "name": "glyphwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contracts:compile": "python -m py_compile contracts/glyphwork_tasks.py contracts/glyphwork_vault.py",
    "contracts:preflight": "node scripts/preflight-contracts.mjs",
    "fixtures:hash": "node scripts/hash-fixtures.mjs",
    "check:network": "node scripts/check-network.mjs",
    "check": "npm run check:network && npm run contracts:compile && npm run contracts:preflight && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "framer-motion": "^12.0.0",
    "genlayer-js": "1.1.8",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "^4.0.0",
    "viem": "^2.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
